{
  "manifest_version": 3,
  "name": "东北大学教务焕新",
  "version": "0.3.81",
  "description": "在独立新标签页中查询东北大学的成绩、考试、个人/全校课表和培养方案。",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://webvpn.neu.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开东北大学教务助手"
  }
}
